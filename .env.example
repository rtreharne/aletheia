# Copy to .env and fill in.
ANTHROPIC_API_KEY=
# Optional overrides
# ALETHEIA_AI_MODEL=claude-opus-5-5             # objectives
# ALETHEIA_AI_QUESTION_MODEL=claude-sonnet-5-5  # each question
# ALETHEIA_AI_EFFORT=medium            # objectives
# ALETHEIA_AI_QUESTION_EFFORT=low      # each question
# For a public HTTPS deployment (needed for real LMS launches):
# SECRET_KEY=
# ALLOWED_HOSTS=aletheiaintegrity.com
# CSRF_TRUSTED_ORIGINS=https://aletheiaintegrity.com
# DEBUG=false
# COOKIES_SECURE=true
# DEV_LOGIN=false                    # /dev/launch/ (localhost only) is on by default
# Email (contact form and call bookings). Without EMAIL_HOST, emails are printed to the app log.
# CONTACT_EMAIL=hello@aletheia.integrityed.com
# DEFAULT_FROM_EMAIL=Aletheia <hello@aletheia.integrityed.com>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# MEETING_URL=https://meet.google.com/xxx-xxxx-xxx   # the video link sent with booked calls
# Legal details shown in /terms, /privacy and the DPA. Blank ones show as [placeholders].
# COMPANY_NAME=Example Ltd
# COMPANY_NUMBER=12345678
# COMPANY_ADDRESS=1 Example Street, London, AB1 2CD
# ICO_REGISTRATION=ZA123456
# HOSTING_PROVIDER=Amazon Web Services EMEA SARL
# HOSTING_LOCATION=London, United Kingdom
# EMAIL_PROVIDER=Postmark (ActiveCampaign LLC)
# EMAIL_PROVIDER_LOCATION=United States
# VIDEO_PROVIDER=Google LLC (Google Meet)
# VIDEO_PROVIDER_LOCATION=United States
# TRANSFER_MECHANISM=the UK International Data Transfer Addendum to the EU Standard Contractual Clauses
# LEGAL_EFFECTIVE_DATE=1 January 2027
